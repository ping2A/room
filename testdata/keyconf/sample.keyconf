// Synthetic KEYCONF fixture for Ferrite parser tests (not from GZDoom).
weaponsection FerriteTest
setslot 1 Fist Pistol
setslot 2 Shotgun
addslotdefault 3 RocketLauncher
addslot 4 PlasmaRifle
alias +ferritezoom "centerview"
defaultbind f "+ferritezoom"
addkeysection "Ferrite Test" FerriteTest
addmenukey "Zoom" "+ferritezoom"
clearplayerclasses
addplayerclass DoomPlayer
addplayerclass Marine nomenu

// Registration-phase host imports (`docs/12` §6) — seed for room-abi-gen.
[
  (
    name: "reg_class_begin",
    scope: "reg",
    params: [
      ("name_ptr", "i32"),
      ("name_len", "i32"),
      ("parent", "i32"),
      ("replaces", "i32"),
      ("doomednum", "i32"),
      ("flags", "i32"),
    ],
    results: ["i32"],
    doc: "Begin a class definition → ClassRef (0 = error).",
  ),
  (
    name: "reg_class_property_i32",
    scope: "reg",
    params: [("prop", "i32"), ("value", "i32")],
    results: [],
    doc: "Set i32 DECORATE property on the open class.",
  ),
  (
    name: "reg_class_flag",
    scope: "reg",
    params: [("flag", "i32"), ("on", "i32")],
    results: [],
    doc: "Set/clear a class default flag.",
  ),
  (
    name: "reg_class_end",
    scope: "reg",
    params: [],
    results: [],
    doc: "Finish the open class definition.",
  ),
  (
    name: "reg_state_label",
    scope: "reg",
    params: [("label_ptr", "i32"), ("label_len", "i32")],
    results: [],
    doc: "Start a state label at the next state index.",
  ),
  (
    name: "reg_state",
    scope: "reg",
    params: [
      ("sprite_ptr", "i32"),
      ("frame", "i32"),
      ("tics", "i32"),
      ("flags", "i32"),
      ("callback_id", "i32"),
    ],
    results: ["i32"],
    doc: "Append a state (sprite = 4 bytes at ptr) → StateRef.",
  ),
  (
    name: "reg_state_flow",
    scope: "reg",
    params: [
      ("kind", "i32"),
      ("label_ptr", "i32"),
      ("label_len", "i32"),
      ("offset", "i32"),
    ],
    results: ["i32"],
    doc: "Flow after last state: 0 Loop, 1 Stop, 2 Wait, 3 Fail, 4 Goto(label,offset). 0=ok.",
  ),
  (
    name: "reg_state_action",
    scope: "reg",
    params: [
      ("name_ptr", "i32"),
      ("name_len", "i32"),
      ("args_ptr", "i32"),
      ("args_len", "i32"),
    ],
    results: ["i32"],
    doc: "Bind native action (DECORATE args string) on the last state. 0=ok.",
  ),
  (
    name: "reg_state_offset",
    scope: "reg",
    params: [("x", "i32"), ("y", "i32")],
    results: ["i32"],
    doc: "Weapon psprite OFFSET(x,y) on the last state. 0=ok.",
  ),
  (
    name: "reg_class_virtual",
    scope: "reg",
    params: [("slot", "i32"), ("callback_id", "i32")],
    results: [],
    doc: "Override a virtual (Tick, DamageMobj, …) with a dispatch id.",
  ),
  (
    name: "reg_event_handler",
    scope: "reg",
    params: [
      ("name_ptr", "i32"),
      ("name_len", "i32"),
      ("order", "i32"),
      ("flags", "i32"),
      ("mask_lo", "i32"),
      ("mask_hi", "i32"),
      ("callback_base", "i32"),
    ],
    results: ["i32"],
    doc: "Register an EventHandler (mask = u64 split lo/hi). 0 = ok.",
  ),
  (
    name: "reg_thinker_class",
    scope: "reg",
    params: [
      ("name_ptr", "i32"),
      ("name_len", "i32"),
      ("statnum", "i32"),
      ("callback_id", "i32"),
    ],
    results: ["i32"],
    doc: "Register a non-actor Thinker class. 0 = ok.",
  ),
  (
    name: "reg_static_function",
    scope: "reg",
    params: [
      ("class_ptr", "i32"),
      ("class_len", "i32"),
      ("func_ptr", "i32"),
      ("func_len", "i32"),
      ("callback_id", "i32"),
    ],
    results: ["i32"],
    doc: "Register ACS ScriptCall target (class.func). 0 = ok.",
  ),
  (
    name: "reg_lump",
    scope: "reg",
    params: [
      ("name_ptr", "i32"),
      ("name_len", "i32"),
      ("namespace", "i32"),
      ("data_ptr", "i32"),
      ("data_len", "i32"),
    ],
    results: ["i32"],
    doc: "Register a generated lump (sprites/sounds/…) → 0 ok, −1 error.",
  ),
  (
    name: "reg_sound_alias",
    scope: "reg",
    params: [
      ("logical_ptr", "i32"),
      ("logical_len", "i32"),
      ("lump_ptr", "i32"),
      ("lump_len", "i32"),
      ("limit", "i32"),
    ],
    results: ["i32"],
    doc: "SNDINFO logical→lump alias (−1 limit = default). 0 = ok.",
  ),
  (
    name: "reg_weapon_slot",
    scope: "reg",
    params: [
      ("slot", "i32"),
      ("class_ptr", "i32"),
      ("class_len", "i32"),
      ("priority", "i32"),
    ],
    results: ["i32"],
    doc: "KEYCONF addslotdefault: slot 1..=10, class name, priority (0 first). 0 = ok.",
  ),
  (
    name: "manifest_option_i32",
    scope: "reg",
    params: [
      ("key_ptr", "i32"),
      ("key_len", "i32"),
      ("default", "i32"),
    ],
    results: ["i32"],
    doc: "Read [options] integer from the mod manifest (registration-only).",
  ),
  (
    name: "manifest_option_str",
    scope: "reg",
    params: [
      ("key_ptr", "i32"),
      ("key_len", "i32"),
      ("buf_ptr", "i32"),
      ("cap", "i32"),
    ],
    results: ["i32"],
    doc: "Copy [options] string into buf; returns length (−1 absent).",
  ),
]

;; Minimal play module sample (M11) — exercises common host imports.
(module
  (import "room" "log" (func $log (param i32 i32 i32)))
  (import "room" "level_time" (func $level_time (result i32)))
  (import "room" "actor_exists" (func $actor_exists (param i64) (result i32)))
  (import "room" "player_count" (func $player_count (result i32)))
  (import "room" "name_intern" (func $name_intern (param i32 i32) (result i32)))
  (import "room" "class_find" (func $class_find (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "hello")
  (data (i32.const 16) "Fire")
  (data (i32.const 32) "Actor")
  (func (export "room_abi_version") (result i32) (i32.const 1))
  (func (export "room_alloc") (param i32 i32) (result i32) (i32.const 64))
  (func (export "room_free") (param i32 i32 i32))
  (func (export "room_register") (result i32)
    (call $log (i32.const 2) (i32.const 0) (i32.const 5))
    (i32.const 0))
  (func (export "room_init") (param i32) (result i32) (i32.const 0))
  ;; 1=level_time 3=player_count 4=name_intern("Fire") 5=class_find("Actor")
  (func (export "room_dispatch") (param $id i32) (param $ptr i32) (param $len i32) (result i64)
    (if (result i64) (i32.eq (local.get $id) (i32.const 1))
      (then (i64.extend_i32_s (call $level_time)))
      (else
        (if (result i64) (i32.eq (local.get $id) (i32.const 3))
          (then (i64.extend_i32_s (call $player_count)))
          (else
            (if (result i64) (i32.eq (local.get $id) (i32.const 4))
              (then (i64.extend_i32_s (call $name_intern (i32.const 16) (i32.const 4))))
              (else
                (if (result i64) (i32.eq (local.get $id) (i32.const 5))
                  (then (i64.extend_i32_s (call $class_find (i32.const 32) (i32.const 5))))
                  (else (i64.const 0))))))))))
)

;; FireImp-style registration sample (M11 / docs/12 §6 + §11).
(module
  (import "room" "log" (func $log (param i32 i32 i32)))
  (import "room" "reg_class_begin" (func $reg_class_begin (param i32 i32 i32 i32 i32 i32) (result i32)))
  (import "room" "reg_class_property_i32" (func $reg_class_property_i32 (param i32 i32)))
  (import "room" "reg_class_flag" (func $reg_class_flag (param i32 i32)))
  (import "room" "reg_class_end" (func $reg_class_end))
  (import "room" "reg_state_label" (func $reg_state_label (param i32 i32)))
  (import "room" "reg_state" (func $reg_state (param i32 i32 i32 i32 i32) (result i32)))
  (import "room" "reg_class_virtual" (func $reg_class_virtual (param i32 i32)))
  (import "room" "class_find" (func $class_find (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "FireImp")
  (data (i32.const 16) "Spawn")
  (data (i32.const 32) "TROO")
  (func (export "room_abi_version") (result i32) (i32.const 1))
  (func (export "room_alloc") (param i32 i32) (result i32) (i32.const 64))
  (func (export "room_free") (param i32 i32 i32))
  (func (export "room_register") (result i32)
    (local $cls i32)
    ;; PropId::Health=1, VirtualSlot::Tick=1, frame 'A'=65
    (local.set $cls
      (call $reg_class_begin
        (i32.const 0) (i32.const 7)
        (i32.const 0) (i32.const 0) (i32.const -1) (i32.const 0)))
    (if (i32.eqz (local.get $cls)) (then (return (i32.const 1))))
    (call $reg_class_property_i32 (i32.const 1) (i32.const 90))
    (call $reg_class_flag (i32.const 1) (i32.const 1))
    (call $reg_state_label (i32.const 16) (i32.const 5))
    (drop (call $reg_state (i32.const 32) (i32.const 65) (i32.const 10) (i32.const 0) (i32.const -1)))
    (call $reg_class_virtual (i32.const 1) (i32.const 42))
    (call $reg_class_end)
    (i32.const 0))
  (func (export "room_init") (param i32) (result i32) (i32.const 0))
  ;; dispatch 1 → class_find("FireImp")
  (func (export "room_dispatch") (param $id i32) (param $ptr i32) (param $len i32) (result i64)
    (if (result i64) (i32.eq (local.get $id) (i32.const 1))
      (then (i64.extend_i32_s (call $class_find (i32.const 0) (i32.const 7))))
      (else (i64.const 0))))
)

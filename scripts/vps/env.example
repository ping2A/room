# Copy to .env next to ./room and edit before first start.
#   cp env.example .env

# Listen on all interfaces (VPS). Behind Caddy, bind 127.0.0.1 instead.
ROOM_BIND=0.0.0.0:8765
ROOM_ADMIN_BIND=0.0.0.0:8766

# Public URLs browsers use (replace with your domain / IP).
ROOM_PLAY_BASE=http://YOUR_VPS_IP:8765/play
ROOM_ORIGIN=http://YOUR_VPS_IP:8765,http://YOUR_VPS_IP:8766
ROOM_ADMIN_RP_ID=YOUR_VPS_IP
ROOM_ADMIN_RP_ORIGIN=http://YOUR_VPS_IP:8766

# Secrets — generate with: openssl rand -base64 32
ROOM_TICKET_SECRET=change-me-ticket-secret-min-16
# First admin only (omit after data/admins.json exists).
ROOM_ADMIN_BOOTSTRAP=admin:change-me-strong-password

# Paths (relative to the package root when using ./room)
ROOM_WEB_ROOT=web
ROOM_DATA_DIR=data
ROOM_MODS_DIR=mods

# Optional: allow gameplay mods on first boot (before data/mods.json).
# ROOM_ALLOW_MODS=royale,bounty,survival

# Production TLS (after Caddy / nginx):
# ROOM_ADMIN_SECURE_COOKIE=true
# ROOM_REQUIRE_TICKETS=true
# ROOM_PLAY_BASE=https://play.example.com/play
# ROOM_ORIGIN=https://play.example.com,https://admin.example.com
# ROOM_ADMIN_RP_ID=admin.example.com
# ROOM_ADMIN_RP_ORIGIN=https://admin.example.com
# ROOM_BIND=127.0.0.1:8765
# ROOM_ADMIN_BIND=127.0.0.1:8766

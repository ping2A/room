# Room VPS — production for 42.bzh (behind Caddy).
# On the VPS: cp env.example .env && edit the two secrets, then ./room start
#   (./room push never overwrites a remote .env)

# Loopback only — Caddy terminates TLS on room.42.bzh / room-admin.42.bzh
ROOM_BIND=127.0.0.1:8765
ROOM_ADMIN_BIND=127.0.0.1:8766

# Public HTTPS origins (must match Caddy hostnames)
ROOM_PLAY_BASE=https://room.42.bzh/play
ROOM_ORIGIN=https://room.42.bzh,https://room-admin.42.bzh
ROOM_ADMIN_RP_ID=room-admin.42.bzh
ROOM_ADMIN_RP_ORIGIN=https://room-admin.42.bzh
ROOM_ADMIN_SECURE_COOKIE=true

# Secrets — replace before first start:
#   openssl rand -base64 32
ROOM_TICKET_SECRET=change-me-ticket-secret-min-16
# First admin only (omit after data/admins.json exists).
#   user:password — use a strong password
ROOM_ADMIN_BOOTSTRAP=admin:change-me-strong-password

# Paths (relative to the package root when using ./room)
ROOM_WEB_ROOT=web
ROOM_DATA_DIR=data
ROOM_MODS_DIR=mods

# Gameplay mods allowed on first boot (before data/mods.json). ./room
# defaults to * (every shipped mod); narrow it here, e.g.:
# ROOM_ALLOW_MODS=royale,bounty,survival
# Shipped library + presets (default: seed/ when present; package with
# --no-seed to ship none).
# ROOM_SEED_DIR=seed

# Optional hardening once tickets are wired from the lobby:
# ROOM_REQUIRE_TICKETS=true
